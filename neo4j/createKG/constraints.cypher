CREATE CONSTRAINT card_name IF NOT EXISTS
FOR (n:Card) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT deck_type_name IF NOT EXISTS
FOR (n:DeckType) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT game_mechanic_name IF NOT EXISTS
FOR (n:GameMechanic) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT role_name IF NOT EXISTS
FOR (n:Role) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT tower_troop_name IF NOT EXISTS
FOR (n:TowerTroop) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT crown_tower_name IF NOT EXISTS
FOR (n:CrownTower) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT document_name IF NOT EXISTS
FOR (n:Document) REQUIRE n.name IS UNIQUE;
CREATE CONSTRAINT chunk_id IF NOT EXISTS
FOR (n:Chunk) REQUIRE n.id IS UNIQUE;
